{
  "sourceLanguage" : "en",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code Island uses Bluetooth in the background to receive lightweight status updates from your Mac, used to refresh Live Activities and keep your Apple Watch in sync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code Island 使用蓝牙在后台接收 Mac 的轻量状态摘要，用于刷新实时活动和同步手表状态。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CodeIsland discovers your Mac on the local network to sync the current session status."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CodeIsland 会在本地网络中发现你的 Mac，用于同步当前会话状态。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
